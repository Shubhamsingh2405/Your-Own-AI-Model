# Server (Streamlit defaults to localhost:8501)
# Run: streamlit run app.py

# Demo vector database
DEMO_DIMS=16

# Ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
# OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=0
EMBEDDING_CACHE_ENABLED=true
LLM_MODEL=llama3.2
GEN_MODEL=llama3.2

# HNSW parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50
HNSW_SEED=42

# Document chunking
CHUNK_SIZE=250
CHUNK_OVERLAP=30

# Document retrieval
DOC_MAX_DIST=0.7

# Hybrid retrieval: vector weight (1-alpha = BM25 weight)
HYBRID_ALPHA=0.7

# RAG abstention threshold (best similarity must exceed this)
RAG_MIN_SIMILARITY=0.25

# Persistence
SQLITE_PATH=data/vectordb.sqlite
